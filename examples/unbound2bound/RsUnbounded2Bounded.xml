<?xml version="1.0"?>
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="https://community.rti.com/schema/7.7.0/rti_routing_service.xsd">
    <types>
        <module name="processor">
            <struct name="UnboundData" extensibility="appendable">
                <member name="data" type="int32" sequenceMaxLength="-1"/>
            </struct>
            <struct name="BoundData" extensibility="appendable">
                <member name="data" type="int32" sequenceMaxLength="500"/>
                <member name="more_data" type="boolean"/>
            </struct>
        </module>
    </types>
    <qos_library name="Unbounded2BoundedQos">
        <qos_profile name="Example">
            <datareader_qos>
                <reliability><kind>RELIABLE_RELIABILITY_QOS</kind></reliability>
                <history><kind>KEEP_ALL_HISTORY_QOS</kind></history>
                <durability><kind>VOLATILE_DURABILITY_QOS</kind></durability>
            </datareader_qos>
            <datawriter_qos>
                <reliability><kind>RELIABLE_RELIABILITY_QOS</kind></reliability>
                <history><kind>KEEP_ALL_HISTORY_QOS</kind></history>
                <durability><kind>VOLATILE_DURABILITY_QOS</kind></durability>
            </datawriter_qos>
        </qos_profile>
    </qos_library>
    <plugin_library name="Unbounded2BoundedPlugins">
        <transformation_plugin name="Unbounded2Bounded">
            <dll>rtiunbounded2boundedtransf</dll>
            <create_function>Unbounded2BoundedTransformationPlugin_create_transformation_plugin</create_function>
        </transformation_plugin>
    </plugin_library>
    <routing_service name="Unbounded2BoundedExample">
        <domain_route name="ExampleDomainRoute">
            <participant name="example">
                <domain_id>0</domain_id>
                <register_type name="processor::UnboundData" type_ref="processor::UnboundData"/>
                <register_type name="processor::BoundData" type_ref="processor::BoundData"/>
            </participant>
            <session name="ExampleSession">
                <topic_route name="Unbounded2BoundedRoute">
                    <input participant="example">
                        <topic_name>unbound_data</topic_name>
                        <registered_type_name>processor::UnboundData</registered_type_name>
                        <creation_mode>IMMEDIATE</creation_mode>
                        <datareader_qos base_name="Unbounded2BoundedQos::Example"/>
                    </input>
                    <output participant="example">
                        <topic_name>bound_data</topic_name>
                        <registered_type_name>processor::BoundData</registered_type_name>
                        <creation_mode>IMMEDIATE</creation_mode>
                        <datawriter_qos base_name="Unbounded2BoundedQos::Example"/>
                        <transformation plugin_name="Unbounded2BoundedPlugins::Unbounded2Bounded">
                            <input_type_name>processor::UnboundData</input_type_name>
                            <input_connection_name>example</input_connection_name>
                        </transformation>
                    </output>
                </topic_route>
            </session>
        </domain_route>
    </routing_service>
</dds>