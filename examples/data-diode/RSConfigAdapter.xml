<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://community.rti.com/schema/current/rti_routing_service.xsd">
    
    <adapter_library name="AdapterLib">
        <adapter_plugin name="SocketAdapter">
            <dll>rtidatadiodeadapter</dll>
            <create_function>SocketAdapter_create_adapter_plugin</create_function>
        </adapter_plugin>
    </adapter_library>

    <routing_service name="SocketAdapterToDDS">
        <domain_route name="SocketBridge">
            <connection name="SocketConnection" plugin_name="AdapterLib::SocketAdapter">
                <register_type name="ShapeType" type_ref="ShapeType"/> <!-- name="ShapeType"/-->
            </connection>
            <participant name="DDSConnectionOutput">
                <domain_id>1</domain_id>
                <participant_qos base_name="BuiltinQosLib::Generic.Common"/>
                <register_type name="ShapeType" type_ref="ShapeType"/> <!-- name="ShapeType"/-->
            </participant>
            <session name="session">
                <route>
                    <input connection="SocketConnection">
                     
                      <creation_mode>ON_ROUTE_MATCH</creation_mode>
                      <!--creation_mode>IMMEDIATE</creation_mode-->
                        <registered_type_name>ShapeType</registered_type_name> 
                        <stream_name>Square</stream_name>
                        <property>
                            <value>
                                <element>
                                    <name>receive_address</name>
                                    <value>127.0.0.1</value>
                                </element>
                                <element>
                                    <name>receive_port</name>
                                    <value>10203</value>
                                </element>
                            </value>
                        </property>
                    </input>
                    <dds_output participant="DDSConnectionOutput">
                      <creation_mode>ON_DOMAIN_MATCH</creation_mode>
                      <!--creation_mode>IMMEDIATE</creation_mode-->
                        <registered_type_name>ShapeType</registered_type_name>
                        <topic_name>Square</topic_name>
                        <datawriter_qos base_name="BuiltinQosLib::Generic.Common"/>
                    </dds_output>
                </route>
            </session>
        </domain_route>
    </routing_service>

    <!-- Demonstrates a scenario where the DDSAdapter reads squares data from a DDS domain (written by Shapes 
            demo and the socketAdapter writes it to a socket connected to the other routing service socket
             -->
            <routing_service name="DDSToSocketAdapter">
                <domain_route name="SocketBridge">
                    <connection name="SocketConnection" plugin_name="AdapterLib::SocketAdapter">
                        <register_type name="ShapeType" type_ref="ShapeType"/> <!-- name="ShapeType"/-->
                    </connection>
                    <participant name="DDSConnectionInput">
                        <domain_id>0</domain_id>
                        <participant_qos base_name="BuiltinQosLib::Generic.Common"/>
                        
                        <register_type name="ShapeType" type_ref="ShapeType"/> <!-- name="ShapeType"/-->
                    </participant>
                    <session name="session">
                        <route>
                            <output connection="SocketConnection">
                              <creation_mode>ON_ROUTE_MATCH</creation_mode>
                              <!--creation_mode>IMMEDIATE</creation_mode-->
                                  <registered_type_name>ShapeType</registered_type_name>
                                <stream_name>Square</stream_name>
                                <property>  <!--Set the IP addresses and ports for sender and destination-->
                                    <value>
                                        <element>
                                            <name>send_address</name>
                                            <value>127.0.0.1</value>
                                        </element>
                                        <element>
                                            <name>send_port</name>
                                            <value>0</value> <!--Set this to 0 for automatic-->
                                        </element>
                                        <element>
                                            <name>dest_address</name>
                                            <value>127.0.0.1</value>
                                        </element>
                                        <element>
                                            <name>dest_port</name>
                                            <value>10203</value>
                                        </element>
                                    </value>
                                </property>
                            </output>
                            <dds_input participant="DDSConnectionInput">
                              <creation_mode>ON_DOMAIN_MATCH</creation_mode>
                              <!--creation_mode>IMMEDIATE</creation_mode-->
                                <registered_type_name>ShapeType</registered_type_name>
                                <topic_name>Square</topic_name>
                                <datareader_qos base_name="BuiltinQosLib::Generic.Common"/>
                            </dds_input>
                        </route>
                    </session>
                </domain_route>
            </routing_service>
</dds>
