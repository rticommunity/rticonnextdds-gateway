<?xml version="1.0"?>
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="https://community.rti.com/schema/7.3.0/rti_routing_service.xsd">
    <types>
        <module name="processor">
            <struct name="unbounddata">
                <member name="data" type="long" sequenceMaxLength="-1"/>
            </struct>
            <struct name="BoundData">
                <member name="data" type="long" sequenceMaxLength="1000"/>
                <member name="more_data" type="boolean"/>
            </struct>
            <struct name="UnboundedFloatData">
                <member name="data" type="double" sequenceMaxLength="-1"/>
            </struct>
            <struct name="BoundedFloatData">
                <member name="data" type="double" sequenceMaxLength="3"/>
                <member name="more_data" type="boolean"/>
            </struct>
        </module>
    </types>
    <plugin_library name="TestPlugins">
        <transformation_plugin name="Unbounded2Bounded">
            <dll>rtiunbounded2boundedtransf</dll>
            <create_function>Unbounded2BoundedTransformationPlugin_create_transformation_plugin</create_function>
        </transformation_plugin>
    </plugin_library>
    <routing_service name="TestService">
        <domain_route name="Unbounded2BoundedDomainRoute">
            <participant name="tester">
                <domain_id>$(U2B_DOMAIN)</domain_id>
                <participant_qos base_name="Unbounded2BoundedQos::default"/>
                <registered_type name="processor::unbounddata" type_name="processor::unbounddata"/>
                <registered_type name="processor::BoundData" type_name="processor::BoundData"/>
                <registered_type name="processor::UnboundedFloatData" type_name="processor::UnboundedFloatData"/>
                <registered_type name="processor::BoundedFloatData" type_name="processor::BoundedFloatData"/>
            </participant>
            <session name="Unbounded2BoundedSession">
                <topic_route name="IntegerRoute">
                    <input participant="tester">
                        <topic_name>UnboundedData</topic_name>
                        <registered_type_name>processor::unbounddata</registered_type_name>
                        <creation_mode>IMMEDIATE</creation_mode>
                        <datareader_qos base_name="Unbounded2BoundedQos::default"/>
                    </input>
                    <output participant="tester">
                        <topic_name>BoundedData</topic_name>
                        <registered_type_name>processor::BoundData</registered_type_name>
                        <creation_mode>IMMEDIATE</creation_mode>
                        <datawriter_qos base_name="Unbounded2BoundedQos::default"/>
                        <transformation plugin_name="TestPlugins::Unbounded2Bounded">
                            <input_type_name>processor::unbounddata</input_type_name>
                            <input_connection_name>tester</input_connection_name>
                        </transformation>
                    </output>
                </topic_route>
                <topic_route name="FloatRoute">
                    <input participant="tester">
                        <topic_name>UnboundedFloatData</topic_name>
                        <registered_type_name>processor::UnboundedFloatData</registered_type_name>
                        <creation_mode>IMMEDIATE</creation_mode>
                        <datareader_qos base_name="Unbounded2BoundedQos::default"/>
                    </input>
                    <output participant="tester">
                        <topic_name>BoundedFloatData</topic_name>
                        <registered_type_name>processor::BoundedFloatData</registered_type_name>
                        <creation_mode>IMMEDIATE</creation_mode>
                        <datawriter_qos base_name="Unbounded2BoundedQos::default"/>
                        <transformation plugin_name="TestPlugins::Unbounded2Bounded">
                            <input_type_name>processor::UnboundedFloatData</input_type_name>
                            <input_connection_name>tester</input_connection_name>
                        </transformation>
                    </output>
                </topic_route>
            </session>
        </domain_route>
    </routing_service>
</dds>