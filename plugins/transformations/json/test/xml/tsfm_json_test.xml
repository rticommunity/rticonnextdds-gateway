<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://community.rti.com/schema/6.0.0/rti_routing_service.xsd">
    <plugin_library name="TestPlugins">
        <transformation_plugin name="JSON">
            <dll>rtijsontransf</dll>
            <create_function>
                RTI_TSFM_JsonTransformationPlugin_create
            </create_function>
        </transformation_plugin>
    </plugin_library>

    <types>
        <include file="tsfm_json_test_message.xml"/>
    </types>

    <routing_service name="TestService">
        <domain_route name="default">
            <participant name="tester_json">
                <domain_id>0</domain_id>
                <participant_qos base_name="TestQos::default"></participant_qos>
                <registered_type name="test::Message" type_name="test::Message"/>
                <registered_type name="test::SerializedMessage" type_name="test::SerializedMessage"/>
            </participant>

            <participant name="tester_repeater">
                <domain_id>1</domain_id>
                <participant_qos base_name="TestQos::default"></participant_qos>
                <registered_type name="test::Message" type_name="test::Message"/>
            </participant>

            <session name="tester" enabled="true">
                <route name="json2dds">
                    <dds_input name="serialized_test_messages" participant="tester_json">
                        <registered_type_name>test::SerializedMessage</registered_type_name>
                        <datareader_qos base_name="TestQos::default"></datareader_qos>
                    </dds_input>
                    <dds_output name="test_messages" participant="tester_repeater">
                        <registered_type_name>test::Message</registered_type_name>
                        <datawriter_qos base_name="TestQos::default"></datawriter_qos>
                        <transformation plugin_name="TestPlugins::JSON">
                            <input_type_name>test::SerializedMessage</input_type_name>
                            <property>
                                <value>
                                    <element>
                                        <name>transform_type</name>
                                        <value>deserialize</value>
                                    </element>
                                    <element>
                                        <name>buffer_member</name>
                                        <value>data</value>
                                    </element>
                                </value>
                            </property>
                        </transformation>
                    </dds_output>
                </route>
                <route name="dds2json">
                    <dds_input name="test_messages" participant="tester_repeater">
                        <registered_type_name>test::Message</registered_type_name>
                        <datareader_qos base_name="TestQos::default"></datareader_qos>
                    </dds_input>
                    <dds_output name="serialized_test_messages" participant="tester_json">
                        <registered_type_name>test::SerializedMessage</registered_type_name>
                        <datawriter_qos base_name="TestQos::default"></datawriter_qos>
                        <transformation plugin_name="TestPlugins::JSON">
                            <input_type_name>test::Message</input_type_name>
                            <property>
                                <value>
                                    <element>
                                        <name>transform_type</name>
                                        <value>serialize</value>
                                    </element>
                                    <element>
                                        <name>buffer_member</name>
                                        <value>data</value>
                                    </element>
                                </value>
                            </property>
                        </transformation>
                    </dds_output>
                </route>
            </session>
        </domain_route>
    </routing_service>
</dds>
