<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="https://community.rti.com/schema/7.3.0/rti_routing_service.xsd">

    <plugin_library name="TestPlugins">
        <transformation_plugin name="Seq2Array">
            <dll>rtisequence2arraytransf</dll>
            <create_function>
                Sequence2ArrayTransformationPlugin_create_transformation_plugin
            </create_function>
        </transformation_plugin>
    </plugin_library>

    <!-- <types>
        <include file="tsfm_seq2array_test_message.xml"/>
    </types> -->

    <routing_service name="TestService">
        <domain_route>
            <participant name="tester">
                <domain_id>0</domain_id>
                <participant_qos base_name="TestQos::default"></participant_qos>
                <!-- <registered_type name="test::inttest1::PubType" type_name="test::inttest1::PubType"/>
                <registered_type name="test::inttest1::SubType" type_name="test::inttest1::SubType"/> -->
            </participant>
            <session name="TestSession">
                <topic_route name="TestRoute">
                    <input participant="tester">
                        <registered_type_name>test::inttest1::PubType</registered_type_name>
                        <topic_name>Seq2ArrayIntTest1Seq</topic_name>
                        <datareader_qos base_name="TestQos::default"></datareader_qos>
                    </input>
                    <output participant="tester">
                        <registered_type_name>test::inttest1::SubType</registered_type_name>
                        <topic_name>Seq2ArrayIntTest1Array</topic_name>
                        <datawriter_qos base_name="TestQos::default"></datawriter_qos>
                        <transformation plugin_name="TestPlugins::Seq2Array"/>
                    </output>
                </topic_route>
            </session>
        </domain_route>
    </routing_service>
</dds>
